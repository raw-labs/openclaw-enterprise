diff --git a/src/gateway/contained-ingress.ts b/src/gateway/contained-ingress.ts
new file mode 100644
index 000000000..770ce70e0
--- /dev/null
+++ b/src/gateway/contained-ingress.ts
@@ -0,0 +1,209 @@
+import { createHash, createPublicKey, verify } from "node:crypto";
+import { IncomingMessage } from "node:http";
+import type { GatewayAuthConfig } from "../config/types.gateway.js";
+
+export type ContainedIngressConfig = NonNullable<GatewayAuthConfig["containedIngress"]>;
+export const CONTAINED_INGRESS_HEADER = "x-oce-ingress";
+const MAX_BODY_BYTES = 25 * 1024 * 1024;
+const MAX_PROOFS = 8192;
+// Proofs issued before this process existed cannot become reusable after a restart.
+const processStartedAt = Date.now();
+const replay = new Map<string, number>();
+
+type OperatorProof = Readonly<{
+  identity: string;
+  clientInstanceId: string;
+  bodySha256: string;
+  expiresAt: number;
+}>;
+export type ContainedIngress =
+  | { kind: "operator"; proof: OperatorProof }
+  | { kind: "credentials" }
+  | { kind: "invalid" };
+const requests = new WeakMap<IncomingMessage, { generation: string; ingress: ContainedIngress }>();
+
+function generation(config: ContainedIngressConfig): string {
+  return JSON.stringify([
+    config.audience,
+    config.verificationKeys
+      .map((key) => [key.keyId, key.publicKeyPem])
+      .sort(([left], [right]) => left!.localeCompare(right!)),
+  ]);
+}
+
+function header(req: IncomingMessage, name: string): string {
+  const value = req.headers[name];
+  return typeof value === "string" ? value : "";
+}
+
+/** Reject unusable verification material before the contained runtime becomes ready. */
+export function validateContainedIngressConfig(config: ContainedIngressConfig): void {
+  const ids = new Set<string>();
+  for (const selected of config.verificationKeys) {
+    if (
+      ids.has(selected.keyId) ||
+      createPublicKey(selected.publicKeyPem).asymmetricKeyType !== "ed25519"
+    ) {
+      throw new Error("Contained ingress requires unique Ed25519 verification keys.");
+    }
+    ids.add(selected.keyId);
+  }
+}
+
+/** Only this verifier produces operator facts; forwarded identities never do. */
+export function readContainedIngress(
+  req: IncomingMessage,
+  config: ContainedIngressConfig,
+): ContainedIngress {
+  const existing = requests.get(req);
+  const current = generation(config);
+  if (existing) {
+    return existing.generation === current ? existing.ingress : { kind: "invalid" };
+  }
+  const result = verifyRequest(req, config);
+  requests.set(req, { generation: current, ingress: result });
+  return result;
+}
+
+function verifyRequest(req: IncomingMessage, config: ContainedIngressConfig): ContainedIngress {
+  if (req.headers[CONTAINED_INGRESS_HEADER] === undefined) {
+    return { kind: "credentials" };
+  }
+  try {
+    const raw = header(req, CONTAINED_INGRESS_HEADER);
+    if (raw.length > 8192 || !/^[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+$/u.test(raw)) {
+      return { kind: "invalid" };
+    }
+    const [encoded, signature] = raw.split(".");
+    const claim: unknown = JSON.parse(Buffer.from(encoded!, "base64url").toString("utf8"));
+    if (!claim || typeof claim !== "object" || Array.isArray(claim)) {
+      return { kind: "invalid" };
+    }
+    const c = claim as Record<string, unknown>;
+    const now = Date.now();
+    const upgrade = header(req, "upgrade").toLowerCase() === "websocket";
+    if (
+      c.version !== 1 ||
+      c.audience !== config.audience ||
+      c.identity !== "occ-workspace-files" ||
+      typeof c.keyId !== "string" ||
+      typeof c.nonce !== "string" ||
+      !/^[0-9a-f-]{36}$/u.test(c.nonce) ||
+      typeof c.issuedAt !== "number" ||
+      !Number.isSafeInteger(c.issuedAt) ||
+      typeof c.expiresAt !== "number" ||
+      !Number.isSafeInteger(c.expiresAt) ||
+      c.issuedAt < processStartedAt ||
+      c.issuedAt > now + 1000 ||
+      c.expiresAt <= now ||
+      c.expiresAt <= c.issuedAt ||
+      c.expiresAt - c.issuedAt > 30_000 ||
+      c.method !== req.method ||
+      c.path !== req.url ||
+      c.origin !== header(req, "origin") ||
+      c.contentType !== header(req, "content-type") ||
+      c.contentEncoding !== header(req, "content-encoding") ||
+      typeof c.bodySha256 !== "string" ||
+      !/^[0-9a-f]{64}$/u.test(c.bodySha256) ||
+      typeof c.websocketKey !== "string" ||
+      typeof c.clientInstanceId !== "string" ||
+      (upgrade
+        ? Boolean(c.websocketKey) === Boolean(c.clientInstanceId) ||
+          (Boolean(c.websocketKey) && c.websocketKey !== header(req, "sec-websocket-key"))
+        : c.websocketKey !== "" || c.clientInstanceId !== "")
+    ) {
+      return { kind: "invalid" };
+    }
+    const selected = config.verificationKeys.find((key) => key.keyId === c.keyId);
+    if (!selected) {
+      return { kind: "invalid" };
+    }
+    const key = createPublicKey(selected.publicKeyPem);
+    if (
+      key.asymmetricKeyType !== "ed25519" ||
+      !verify(null, Buffer.from(encoded!), key, Buffer.from(signature!, "base64url"))
+    ) {
+      return { kind: "invalid" };
+    }
+    for (const [nonce, expiry] of replay) {
+      if (expiry <= now) {
+        replay.delete(nonce);
+      }
+    }
+    const replayKey = config.audience + ":" + c.nonce;
+    if (replay.has(replayKey) || replay.size >= MAX_PROOFS) {
+      return { kind: "invalid" };
+    }
+    replay.set(replayKey, c.expiresAt);
+    return {
+      kind: "operator",
+      proof: Object.freeze({
+        identity: c.identity,
+        clientInstanceId: c.clientInstanceId,
+        bodySha256: c.bodySha256,
+        expiresAt: c.expiresAt,
+      }),
+    };
+  } catch {
+    return { kind: "invalid" };
+  }
+}
+
+/** Capability lanes remain independently authenticated by their existing route owners. */
+export function containedCredentialHttpPath(path: string): boolean {
+  const pathname = path.split("?", 1)[0];
+  return [
+    "/__openclaw__/worker-bundle/v1/",
+    "/__openclaw__/worker-transfer/v1/",
+    "/__openclaw__/native-hook/",
+  ].some((prefix) => pathname?.startsWith(prefix));
+}
+
+/** Verify the complete signed body before any administrative route can act on it. */
+export async function prepareContainedHttpRequest(
+  req: IncomingMessage,
+  config: ContainedIngressConfig | undefined,
+): Promise<IncomingMessage | undefined> {
+  if (!config) {
+    return req;
+  }
+  const ingress = readContainedIngress(req, config);
+  if (ingress.kind === "invalid") {
+    return undefined;
+  }
+  if (ingress.kind === "credentials") {
+    return req;
+  }
+  const chunks: Buffer[] = [];
+  let size = 0;
+  for await (const chunk of req) {
+    const bytes = Buffer.isBuffer(chunk) ? chunk : Buffer.from(chunk);
+    size += bytes.length;
+    if (size > MAX_BODY_BYTES) {
+      return undefined;
+    }
+    chunks.push(bytes);
+  }
+  const body = Buffer.concat(chunks);
+  if (
+    Date.now() >= ingress.proof.expiresAt ||
+    createHash("sha256").update(body).digest("hex") !== ingress.proof.bodySha256
+  ) {
+    return undefined;
+  }
+  // Administrative route owners consume the same verified bytes through their usual
+  // IncomingMessage body readers. The original socket and lifecycle remain in use.
+  const admitted = new IncomingMessage(req.socket);
+  admitted.method = req.method;
+  admitted.url = req.url;
+  admitted.headers = req.headers;
+  admitted.rawHeaders = req.rawHeaders;
+  admitted.httpVersion = req.httpVersion;
+  admitted.httpVersionMajor = req.httpVersionMajor;
+  admitted.httpVersionMinor = req.httpVersionMinor;
+  admitted.complete = true;
+  requests.set(admitted, { generation: generation(config), ingress });
+  admitted.push(body);
+  admitted.push(null);
+  return admitted;
+}
diff --git a/src/gateway/server.contained-ingress.test.ts b/src/gateway/server.contained-ingress.test.ts
new file mode 100644
index 000000000..024afa218
--- /dev/null
+++ b/src/gateway/server.contained-ingress.test.ts
@@ -0,0 +1,229 @@
+import { createHash, generateKeyPairSync, randomUUID, sign } from "node:crypto";
+import { expect, test } from "vitest";
+import type { GatewayAuthConfig } from "../config/types.gateway.js";
+import { decodePairingSetupCode } from "../pairing/setup-code.js";
+import { captureGatewayAuthPolicy, isGatewayAuthPolicyCurrent } from "./auth-policy.js";
+import { loadDeviceIdentity } from "./device-authz.test-helpers.js";
+import * as gateway from "./server.auth.test-helpers.js";
+
+gateway.installGatewayTestHooks({ scope: "suite" });
+const pair = generateKeyPairSync("ed25519");
+const publicKeyPem = pair.publicKey.export({ type: "spki", format: "pem" }).toString();
+const audience = "agent-test/revision-1/workload-1";
+const origin = gateway.BROWSER_ORIGIN;
+const auth: GatewayAuthConfig = {
+  mode: "trusted-proxy",
+  containedIngress: {
+    audience,
+    verificationKeys: [{ keyId: "test", publicKeyPem }],
+  },
+  trustedProxy: {
+    userHeader: "x-occ-identity",
+    allowLoopback: false,
+    allowUsers: ["occ-workspace-files"],
+  },
+  identityScopes: { "occ-workspace-files": ["operator.admin"] },
+};
+
+function proof(
+  path: string,
+  options: {
+    method?: string;
+    body?: string;
+    instanceId?: string;
+    overrides?: Record<string, unknown>;
+  } = {},
+) {
+  const now = Date.now();
+  const encoded = Buffer.from(
+    JSON.stringify({
+      version: 1,
+      keyId: "test",
+      audience,
+      identity: "occ-workspace-files",
+      issuedAt: now,
+      expiresAt: now + 30_000,
+      nonce: randomUUID(),
+      method: options.method ?? "GET",
+      path,
+      origin: options.instanceId ? "" : origin,
+      websocketKey: "",
+      clientInstanceId: options.instanceId ?? "",
+      contentType: options.body === undefined ? "" : "application/json",
+      contentEncoding: "",
+      bodySha256: createHash("sha256")
+        .update(options.body ?? "")
+        .digest("hex"),
+      ...options.overrides,
+    }),
+  ).toString("base64url");
+  return encoded + "." + sign(null, Buffer.from(encoded), pair.privateKey).toString("base64url");
+}
+
+// Reach the real HTTP route/auth owners, not an imitation verifier.
+test("contained HTTP binds authority to request, body, origin, audience and one nonce", async () => {
+  await gateway.configureBrowserAuth(auth);
+  await gateway.withGatewayServer(async ({ port }) => {
+    const url = "http://127.0.0.1:" + port + "/tools/invoke";
+    const body = "{}";
+    const acceptedProof = proof("/tools/invoke", { method: "POST", body });
+    const send = (token: string, bytes = body, requestOrigin = origin) =>
+      fetch(url, {
+        method: "POST",
+        body: bytes,
+        headers: {
+          "content-type": "application/json",
+          origin: requestOrigin,
+          "x-oce-ingress": token,
+        },
+      });
+    const accepted = await send(acceptedProof);
+    expect(accepted.status, await accepted.text()).toBe(400);
+    // Replaying a correct signed mutation must not reach its route again.
+    expect((await send(acceptedProof)).status).toBe(401);
+    expect(
+      (await send(proof("/tools/invoke", { method: "POST", body }), '{"changed":true}')).status,
+    ).toBe(401);
+    expect(
+      (await send(proof("/tools/invoke", { method: "POST", body }), body, "https://other.invalid"))
+        .status,
+    ).toBe(401);
+    for (const overrides of [{ audience: "another-agent" }, { expiresAt: 1 }, { method: "GET" }]) {
+      expect((await send(proof("/tools/invoke", { method: "POST", body, overrides }))).status).toBe(
+        401,
+      );
+    }
+    expect((await send(proof("/another-path", { method: "POST", body }))).status).toBe(401);
+    expect((await send("forged.invalid")).status).toBe(401);
+    const unsigned = await fetch(url, {
+      method: "POST",
+      body,
+      headers: {
+        "content-type": "application/json",
+        "x-occ-identity": "occ-workspace-files",
+        "x-forwarded-for": "127.0.0.1",
+      },
+    });
+    expect(unsigned.status).toBe(401);
+    expect((await fetch("http://127.0.0.1:" + port + "/healthz")).status).toBe(200);
+  });
+});
+
+// Use the native setup RPC, signed device challenge, pairing store and issued node token.
+test("contained operator evidence cannot become node authority and unsigned nodes retain native credentials", async () => {
+  await gateway.configureBrowserAuth(auth);
+  await gateway.withGatewayServer(async ({ port }) => {
+    const sockets: Awaited<ReturnType<typeof gateway.openWs>>[] = [];
+    const instanceId = randomUUID();
+    const operator = await gateway.openWs(port, {
+      "x-oce-ingress": proof("/", { instanceId }),
+    });
+    sockets.push(operator);
+    const connected = await gateway.connectReq(operator, {
+      client: { ...gateway.BACKEND_GATEWAY_CLIENT, instanceId },
+      role: "operator",
+      scopes: [],
+      device: null,
+      skipDefaultAuth: true,
+    });
+    expect(connected.ok, JSON.stringify(connected.error)).toBe(true);
+    expect(connected.payload?.auth).toMatchObject({
+      role: "operator",
+      scopes: ["operator.admin"],
+    });
+    try {
+      const setup = await gateway.rpcReq<{ setupCode: string }>(operator, "device.pair.setupCode", {
+        bootstrapProfile: "node",
+        includeQr: false,
+        publicUrl: "wss://node.example.invalid",
+      });
+      expect(setup.ok, JSON.stringify(setup.error)).toBe(true);
+      const payload = decodePairingSetupCode(setup.payload!.setupCode);
+      const identity = loadDeviceIdentity("contained-node");
+      const connectNode = async (
+        options: Parameters<typeof gateway.connectReq>[1],
+        signed = false,
+      ) => {
+        const ws = await gateway.openWs(
+          port,
+          signed
+            ? { "x-oce-ingress": proof("/", { instanceId }) }
+            : {
+                "x-forwarded-for": "127.0.0.1",
+                "x-occ-identity": "occ-workspace-files",
+              },
+        );
+        sockets.push(ws);
+        return gateway.connectReq(ws, {
+          role: "node",
+          scopes: [],
+          client: gateway.NODE_CLIENT,
+          deviceIdentityPath: identity.identityPath,
+          skipDefaultAuth: true,
+          ...options,
+        });
+      };
+      const node = await connectNode({
+        bootstrapToken: payload.bootstrapToken,
+      });
+      expect(node.ok, JSON.stringify(node.error)).toBe(true);
+      expect(node.payload?.auth).toMatchObject({ role: "node", scopes: [] });
+      const nodeAuth = node.payload?.auth;
+      if (
+        !nodeAuth ||
+        typeof nodeAuth !== "object" ||
+        !("deviceToken" in nodeAuth) ||
+        typeof nodeAuth.deviceToken !== "string"
+      ) {
+        throw new Error("Native node bootstrap did not issue its device token.");
+      }
+      const nodeToken = nodeAuth.deviceToken;
+      expect((await connectNode({ deviceToken: nodeToken })).ok).toBe(true);
+      expect((await connectNode({ deviceToken: "invalid-node-token" })).ok).toBe(false);
+      expect(
+        (
+          await connectNode({
+            deviceToken: nodeToken,
+            role: "operator",
+            scopes: ["operator.admin"],
+          })
+        ).ok,
+      ).toBe(false);
+      expect((await connectNode({ bootstrapToken: payload.bootstrapToken }, true)).ok).toBe(false);
+      const revoked = await gateway.rpcReq(operator, "device.token.revoke", {
+        deviceId: identity.identity.deviceId,
+        role: "node",
+      });
+      expect(revoked.ok, JSON.stringify(revoked.error)).toBe(true);
+      expect((await connectNode({ deviceToken: nodeToken })).ok).toBe(false);
+    } finally {
+      for (const socket of sockets) {
+        socket.close();
+      }
+    }
+  });
+});
+
+// Existing sockets must lose transport authority when their verification policy changes.
+test("contained key and audience changes invalidate captured Gateway authority", () => {
+  const config = { gateway: { auth } };
+  const policy = captureGatewayAuthPolicy(config, {
+    role: "operator",
+    authMethod: "trusted-proxy",
+    verifiedIdentity: "occ-workspace-files",
+  });
+  expect(isGatewayAuthPolicyCurrent(policy, config)).toBe(true);
+  for (const containedIngress of [
+    { ...auth.containedIngress!, audience: "another-workload" },
+    {
+      ...auth.containedIngress!,
+      verificationKeys: [{ keyId: "rotated", publicKeyPem }],
+    },
+  ]) {
+    expect(
+      isGatewayAuthPolicyCurrent(policy, {
+        gateway: { auth: { ...auth, containedIngress } },
+      }),
+    ).toBe(false);
+  }
+});
