# SPDX-License-Identifier: Apache-2.0
# Based on Moby v28.0.0 profiles/apparmor/template.go:
# https://github.com/moby/moby/blob/v28.0.0/profiles/apparmor/template.go
# CI containers retain Docker's default restrictions except nested mount and
# pivot-root permissions. The reviewed seccomp profile bounds namespace/mount
# operations; dropped capabilities keep them inside the nested user namespace.
# This profile is installed only on the ephemeral native-startup CI runner.
#include <tunables/global>

profile oce-ci-codex-bwrap flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>
  network,
  capability,
  file,
  umount,
  mount,
  pivot_root,
  signal (receive) peer=unconfined,
  signal (receive) peer=runc,
  signal (receive) peer=crun,
  signal (send,receive) peer=oce-ci-codex-bwrap,
  deny @{PROC}/* w,
  deny @{PROC}/{[^1-9],[^1-9][^0-9],[^1-9s][^0-9y][^0-9s],[^1-9][^0-9][^0-9][^0-9/]*}/** w,
  deny @{PROC}/sys/[^k]** w,
  deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,
  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/devices/virtual/powercap/** rwklx,
  deny /sys/kernel/security/** rwklx,
  ptrace (trace,read,tracedby,readby) peer=oce-ci-codex-bwrap,
}
